MONGO_URL=mongodb://localhost:27017/roomflix
ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# TMDB discovery integration.
TMDB_API_KEY=

# Optional IMDb ratings through OMDb. Free key: https://www.omdbapi.com/apikey.aspx
# Server only; never use a VITE_ prefix for this key.
OMDB_API_KEY=

# Reserved for the later Pulse Lab implementation. Never expose this in the
# Vite client or include it in account exports.
OPENAI_API_KEY=
