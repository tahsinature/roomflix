# Connection string for MongoDB. Required — the server refuses to start
# without it. Atlas users: paste the SRV URI here (mongodb+srv://...).
# Local dev with docker-compose: leave as-is and the local mongo service
# is used.
MONGO_URL=mongodb://localhost:27017/roomflix

# Toggle open registration. Default: true. Flip to false once your admin
# account exists. A carve-out lets the *first ever* user register even
# when this is false, so a fresh deployment is never bricked.
ALLOW_REGISTRATION=true

# Whether the session cookie sets the Secure flag. Default: true when
# NODE_ENV=production, false otherwise. Set to false for local HTTP dev,
# true for any deployment served over HTTPS.
COOKIE_SECURE=false

# Standard NODE_ENV switch. Affects log labels and cookie defaults.
NODE_ENV=development

# HTTP port the Bun server binds to. Default: 3000.
PORT=3000

# Server-held key for symmetric encryption of secrets-at-rest (e.g. R2
# secret access keys stored in user storage configs). Required — refuse
# to boot without it. Generate once with:
#   openssl rand -base64 32
ENCRYPTION_KEY="to3dgBLbRWWvJo+oDO8bWwFkgNysdi7BCUKA7QJpW7Q="
