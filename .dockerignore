# Build artifacts — the Dockerfile builds these fresh inside the builder stage.
**/node_modules
**/dist

# VCS / editor
.git
.gitignore
.gitattributes
.vscode
.idea

# OS
**/.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env — match at any depth (server/.env, client/.env, etc.) so
# dev secrets never bake into the prod image. The prod container
# pulls fresh .env from Doppler at startup via scripts/run-prod.sh.
**/.env
**/.env.*

# Repo / agent metadata — not needed in the image
README.md
CLAUDE.md
.claude
.cursor

# Docker meta itself
Dockerfile
.dockerignore

# Test/coverage
coverage
