{
  "name": "roomflix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun run --cwd server dev",
    "dev:client": "bun run --cwd client dev",
    "build": "bun run --cwd client build",
    "test": "bun test tests && bun run --cwd server test",
    "search-index:build": "bun run scripts/build-tmdb-search-index.ts",
    "start": "NODE_ENV=production bun run --cwd server start",
    "format": "prettier --write \"{client,server}/**/*.{ts,tsx,json,md,css}\" \"!**/dist/**\" \"!**/node_modules/**\"",
    "format:check": "prettier --check \"{client,server}/**/*.{ts,tsx,json,md,css}\" \"!**/dist/**\" \"!**/node_modules/**\""
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "^5.6.3"
  }
}
